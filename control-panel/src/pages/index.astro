---
import Layout from '../layouts/Layout.astro';
import PageNav from '../components/PageNav.svelte';
import PokemonList from '../components/PokemonList.svelte';
import PokemonEditor from '../components/PokemonEditor.svelte';
---

<Layout title="PokéEmerald Control Panel">
  <div class="app-container">
    <div class="sidebar">
      <div class="sidebar-header">
        <PageNav client:load current="/" />
      </div>
      <PokemonList client:load />
    </div>

    <div class="main-content">
      <PokemonEditor client:load />
    </div>
  </div>
</Layout>

<style is:global>
  /* The moves UI (.levelup-row, .move-select, .tmhm-row, …) is built
     dynamically by JavaScript inside PokemonEditor. Astro's per-component
     scoped <style> can't reach those DOM nodes, so this stylesheet is
     declared global and lives at the page level. */
  .moves-section-wrap {
    margin-top: 2rem;
  }
  .tmhm-search {
    width: 100%;
    height: 32px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.6rem;
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .tmhm-search:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }
  .tmhm-search::placeholder { color: var(--muted); }

  /* HM rows: green accent so they're clearly distinguishable from TMs */
  .tmhm-row.is-hm {
    border-left: 3px solid var(--accent-2);
    background: rgba(158, 206, 106, 0.05);
  }
  .tmhm-row.is-hm .tmhm-tag {
    color: var(--accent-2);
    border-color: rgba(158, 206, 106, 0.4);
    background: rgba(158, 206, 106, 0.1);
  }
  .tmhm-row.is-hm:has(.tmhm-check:checked) {
    background: rgba(122, 162, 247, 0.08);
    border-left-color: var(--accent-2);
  }
  .levelup-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .levelup-row {
    display: grid;
    grid-template-columns: 72px 1fr 34px;
    gap: 0.5rem;
    align-items: center;
  }
  .levelup-row .move-level,
  .levelup-row .move-select {
    height: 34px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.6rem;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .levelup-row .move-level {
    text-align: center;
    -moz-appearance: textfield;
  }
  .levelup-row .move-level::-webkit-outer-spin-button,
  .levelup-row .move-level::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .levelup-row .move-select {
    appearance: none;
    -webkit-appearance: none;
    min-width: 0;
    padding-right: 1.8rem;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239aa3b2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.6rem center;
    background-size: 14px;
  }
  .levelup-row .move-level:focus,
  .levelup-row .move-select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }
  .move-remove {
    height: 34px;
    width: 34px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .move-remove:hover {
    color: var(--danger);
    border-color: var(--danger);
    background: rgba(247, 118, 142, 0.08);
  }
  .btn-add-move {
    margin-top: 0.5rem;
    width: 100%;
    background: transparent;
    border: 1px dashed var(--border);
    border-radius: 6px;
    color: var(--muted);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0.55rem 0.6rem;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .btn-add-move:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(122, 162, 247, 0.06);
  }
  .tmhm-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .tmhm-row {
    display: grid;
    grid-template-columns: 18px 44px 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    user-select: none;
    border: 1px solid transparent;
    transition: background 0.15s, border-color 0.15s;
  }
  .tmhm-row:hover { background: var(--panel-2); }
  .tmhm-row:has(.tmhm-check:checked) {
    background: rgba(122, 162, 247, 0.08);
    border-color: rgba(122, 162, 247, 0.35);
  }
  .tmhm-row .tmhm-check {
    cursor: pointer;
    margin: 0;
    width: 16px;
    height: 16px;
    appearance: none;
    -webkit-appearance: none;
    justify-self: center;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 12px;
    transition: background 0.15s, border-color 0.15s;
  }
  .tmhm-row .tmhm-check:hover { border-color: var(--accent); }
  .tmhm-row .tmhm-check:checked {
    background-color: var(--accent);
    border-color: var(--accent);
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230f1115' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='20 6 9 17 4 12'%3e%3c/polyline%3e%3c/svg%3e");
  }
  .tmhm-row .tmhm-tag {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.74rem;
    text-align: center;
    padding: 0.2rem 0;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.3px;
  }
  .tmhm-row:has(.tmhm-check:checked) .tmhm-tag {
    color: var(--accent);
    border-color: rgba(122, 162, 247, 0.4);
    background: rgba(122, 162, 247, 0.12);
  }

  /* Evolution tree (horizontal: root on the left, children to the right) */
  .evolution-chain { position: relative; margin: 0 auto; }
  .evolution-section-wrap { margin-top: 2rem; overflow-x: auto; }
  .evo-tile {
    position: absolute;
    width: 220px;
    height: 235px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.2rem;
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .evo-tile-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 1;
    text-align: center;
    width: 100%;
  }
  .evo-tile.is-current {
    border-color: var(--accent);
    background: rgba(122, 162, 247, 0.08);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }
  .evo-tile .evo-sprite {
    width: 80px;
    height: 80px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    object-fit: cover;
    object-position: top;
  }
  .evo-tile .evo-name {
    font-size: 0.88rem;
    font-weight: 600;
    text-align: center;
    color: var(--text);
    line-height: 1.15;
  }
  .evo-tile .evo-add {
    align-self: stretch;
    height: 34px;
    padding: 0 0.7rem;
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 6px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
    margin-top: 0.6rem;
  }
  .evo-tile .evo-add:hover { background: #6b91e6; border-color: #6b91e6; }
  .evo-connector {
    position: absolute;
    width: 220px;
    height: 235px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    justify-content: center;
  }
  .evo-connector .evo-save,
  .evo-connector .evo-delete {
    height: 34px;
    padding: 0 0.7rem;
    border-radius: 6px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s, opacity 0.15s;
  }
  .evo-connector .evo-save {
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
  }
  .evo-connector .evo-save:hover:not(:disabled) { background: #6b91e6; border-color: #6b91e6; }
  .evo-connector .evo-save:disabled {
    background: var(--panel);
    color: var(--muted);
    border-color: var(--border);
    cursor: not-allowed;
    opacity: 0.55;
  }
  .evo-connector .evo-delete {
    background: var(--danger);
    color: white;
    border: 1px solid var(--danger);
  }
  .evo-connector .evo-delete:hover { background: #e0607a; border-color: #e0607a; }
  .evo-line {
    position: absolute;
    height: 235px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .evo-line::before {
    content: '';
    width: 100%;
    height: 2px;
    background: var(--accent);
  }
  .evo-arrow {
    position: absolute;
    width: 28px;
    height: 235px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    pointer-events: none;
  }
  .evo-arrow::before {
    content: '';
    width: 0; height: 0;
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
    border-left: 24px solid var(--accent);
  }
  .evo-connector select,
  .evo-connector input {
    height: 34px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.6rem;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    width: 100%;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .evo-connector select {
    appearance: none;
    -webkit-appearance: none;
    min-width: 0;
    padding-right: 1.8rem;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239aa3b2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.6rem center;
    background-size: 14px;
  }
  .evo-connector select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }
  .evo-connector input { text-align: center; -moz-appearance: textfield; }
  .evo-connector input::-webkit-outer-spin-button,
  .evo-connector input::-webkit-inner-spin-button {
    -webkit-appearance: none; margin: 0;
  }
  .evo-connector .evo-target { font-weight: 600; }
  .evo-empty {
    color: var(--muted);
    font-size: 0.88rem;
    padding: 0.4rem 0;
  }
</style>

<style>
  .app-container {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  .sidebar {
    width: 320px;
    background: var(--panel);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .main-content {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
  }
</style>
