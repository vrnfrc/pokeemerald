---

<Layout title="PokéEmerald Control Panel">
  <div class="app-container">
    <div class="sidebar">
      <div class="sidebar-header">
        <h1>Pokémon</h1>
      </div>
      <PokemonList client:load />
    </div>

    <div class="main-content">
      <div id="status" class="status"></div>
      
      <div id="editor" class="editor" style="display: none;">
        <div class="editor-header">
          <img id="pokemon-sprite" class="editor-sprite" alt="" />
          <h2 id="pokemon-name"></h2>
        </div>

        <form id="pokemon-form">
          <div class="editor-layout">
            <div class="editor-left">
              <div class="form-section">
                <h3>Types</h3>
                <div class="type-chips-container">
                  <button type="button" id="type1-chip" class="type-chip" data-type=""></button>
                  <button type="button" id="type2-chip" class="type-chip" data-type=""></button>
                </div>
                <div id="type-picker" class="type-picker" hidden></div>
              </div>

              <div class="form-section">
                <h3>Abilities</h3>
                <div class="form-row">
                  <select id="ability1" name="ability1" class="ability-select">
                    {abilityOptions.map(opt => (
                      <option value={opt.value} selected={opt.value === 'ABILITY_NONE'}>{opt.label}</option>
                    ))}
                  </select>
                  <select id="ability2" name="ability2" class="ability-select">
                    {abilityOptions.map(opt => (
                      <option value={opt.value} selected={opt.value === 'ABILITY_NONE'}>{opt.label}</option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            <div class="editor-right">
              <div class="form-section">
                <h3>Base Stats</h3>
                <div class="stats-container">
                  <div class="stat-row" style="--stat-color: #78C850;">
                    <label class="stat-label" for="baseHP">HP</label>
                    <input type="range" id="baseHP" name="baseHP" min="1" max="255" class="stat-slider" />
                    <span class="stat-value" id="baseHP-value">0</span>
                  </div>
                  <div class="stat-row" style="--stat-color: #F8D030;">
                    <label class="stat-label" for="baseAttack">ATK</label>
                    <input type="range" id="baseAttack" name="baseAttack" min="1" max="255" class="stat-slider" />
                    <span class="stat-value" id="baseAttack-value">0</span>
                  </div>
                  <div class="stat-row" style="--stat-color: #F08030;">
                    <label class="stat-label" for="baseDefense">DEF</label>
                    <input type="range" id="baseDefense" name="baseDefense" min="1" max="255" class="stat-slider" />
                    <span class="stat-value" id="baseDefense-value">0</span>
                  </div>
                  <div class="stat-row" style="--stat-color: #6890F0;">
                    <label class="stat-label" for="baseSpAttack">SPA</label>
                    <input type="range" id="baseSpAttack" name="baseSpAttack" min="1" max="255" class="stat-slider" />
                    <span class="stat-value" id="baseSpAttack-value">0</span>
                  </div>
                  <div class="stat-row" style="--stat-color: #98D8D8;">
                    <label class="stat-label" for="baseSpDefense">SPD</label>
                    <input type="range" id="baseSpDefense" name="baseSpDefense" min="1" max="255" class="stat-slider" />
                    <span class="stat-value" id="baseSpDefense-value">0</span>
                  </div>
                  <div class="stat-row" style="--stat-color: #7038F8;">
                    <label class="stat-label" for="baseSpeed">SPE</label>
                    <input type="range" id="baseSpeed" name="baseSpeed" min="1" max="255" class="stat-slider" />
                    <span class="stat-value" id="baseSpeed-value">0</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-section evolution-section-wrap">
            <h3>Evolution</h3>
            <div id="evolution-chain" class="evolution-chain"></div>
          </div>

          <div class="form-section moves-section-wrap">
            <h3>Moves</h3>
            <div class="moves-grid">
              <div>
                <h4>Level Up</h4>
                <div id="levelup-moves" class="levelup-list"></div>
                <button type="button" id="add-levelup" class="btn btn-add-move">+ Add Move</button>
              </div>
              <div>
                <h4>TM/HM</h4>
                <input
                  type="text"
                  id="tmhm-search"
                  class="tmhm-search"
                  placeholder="Search TM/HM…"
                  autocomplete="off"
                />
                <div id="tmhm-moves" class="tmhm-list"></div>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>
      </div>

      <div id="empty-state" class="empty-state">
        <div class="empty-icon">📊</div>
        <h2>Select a Pokémon</h2>
        <p>Choose a Pokémon from the list to edit its information</p>
      </div>
    </div>
  </div>
</Layout>

<script type="application/json" id="moves-data" set:html={movesDataJson}></script>

<style is:global>
  /* The moves UI (.levelup-row, .move-select, .tmhm-row, …) is built
     dynamically by JavaScript in renderMoves(). Astro's per-component
     scoped <style> can't reach those DOM nodes, so this stylesheet is
     declared global and lives at the page level. */
  .moves-section-wrap {
    margin-top: 2rem;
  }
  .tmhm-search {
    width: 100%;
    height: 32px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.6rem;
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .tmhm-search:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }
  .tmhm-search::placeholder { color: var(--muted); }

  /* HM rows: green accent so they're clearly distinguishable from TMs */
  .tmhm-row.is-hm {
    border-left: 3px solid var(--accent-2);
    background: rgba(158, 206, 106, 0.05);
  }
  .tmhm-row.is-hm .tmhm-tag {
    color: var(--accent-2);
    border-color: rgba(158, 206, 106, 0.4);
    background: rgba(158, 206, 106, 0.1);
  }
  .tmhm-row.is-hm:has(.tmhm-check:checked) {
    background: rgba(122, 162, 247, 0.08);
    border-left-color: var(--accent-2);
  }
  .levelup-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .levelup-row {
    display: grid;
    grid-template-columns: 72px 1fr 34px;
    gap: 0.5rem;
    align-items: center;
  }
  .levelup-row .move-level,
  .levelup-row .move-select {
    height: 34px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.6rem;
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .levelup-row .move-level {
    text-align: center;
    -moz-appearance: textfield;
  }
  .levelup-row .move-level::-webkit-outer-spin-button,
  .levelup-row .move-level::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .levelup-row .move-select {
    appearance: none;
    -webkit-appearance: none;
    min-width: 0;
    padding-right: 1.8rem;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239aa3b2' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.6rem center;
    background-size: 14px;
  }
  .levelup-row .move-level:focus,
  .levelup-row .move-select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }
  .move-remove {
    height: 34px;
    width: 34px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .move-remove:hover {
    color: var(--danger);
    border-color: var(--danger);
    background: rgba(247, 118, 142, 0.08);
  }
  .btn-add-move {
    margin-top: 0.5rem;
    width: 100%;
    background: transparent;
    border: 1px dashed var(--border);
    border-radius: 6px;
    color: var(--muted);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0.55rem 0.6rem;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .btn-add-move:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(122, 162, 247, 0.06);
  }
  .tmhm-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .tmhm-row {
    display: grid;
    grid-template-columns: 18px 44px 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    user-select: none;
    border: 1px solid transparent;
    transition: background 0.15s, border-color 0.15s;
  }
  .tmhm-row:hover { background: var(--panel-2); }
  .tmhm-row:has(.tmhm-check:checked) {
    background: rgba(122, 162, 247, 0.08);
    border-color: rgba(122, 162, 247, 0.35);
  }
  .tmhm-row .tmhm-check {
    cursor: pointer;
    margin: 0;
    width: 16px;
    height: 16px;
    appearance: none;
    -webkit-appearance: none;
    justify-self: center;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 12px;
    transition: background 0.15s, border-color 0.15s;
  }
  .tmhm-row .tmhm-check:hover { border-color: var(--accent); }
  .tmhm-row .tmhm-check:checked {
    background-color: var(--accent);
    border-color: var(--accent);
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230f1115' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='20 6 9 17 4 12'%3e%3c/polyline%3e%3c/svg%3e");
  }
  .tmhm-row .tmhm-tag {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.74rem;
    text-align: center;
    padding: 0.2rem 0;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.3px;
  }
  .tmhm-row:has(.tmhm-check:checked) .tmhm-tag {
    color: var(--accent);
    border-color: rgba(122, 162, 247, 0.4);
    background: rgba(122, 162, 247, 0.12);
  }

  /* Evolution tree (horizontal: root on the left, children to the right) */
  .evolution-chain { position: relative; margin: 0 auto; }
  .evolution-section-wrap { margin-top: 2rem; overflow-x: auto; }
  .evo-tile {
    position: absolute;
    width: 220px;
    height: 235px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* sprite+name centered in the space above the + button */
    gap: 0.4rem;
    padding: 1.2rem;
    padding-bottom: 4.5rem; /* dedicated room for the + button at the bottom */
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .evo-tile.is-current {
    border-color: var(--accent);
    background: rgba(122, 162, 247, 0.08);
    box-shadow: 0 0 0 2px rgba(122, 162, 247, 0.2);
  }
  .evo-tile .evo-sprite {
    width: 80px;
    height: 80px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    object-fit: cover;
    object-position: top;
  }
  .evo-tile .evo-name {
    font-size: 0.88rem;
    font-weight: 600;
    text-align: center;
    color: var(--text);
    line-height: 1.15;
  }
  /* "+" button on the current Pokemon's tile */
  .evo-tile .evo-add {
    position: absolute;
    bottom: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    border: none;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    /* Perfectly center the glyph: line-height matches the button height,
       text-align centers horizontally, vertical-align:middle on an inline-block
       ::before baseline-aligns the character to the visual center. */
    line-height: 32px;
    text-align: center;
    transition: background 0.15s, transform 0.1s;
  }
  .evo-tile .evo-add::before {
    content: '';
    display: inline-block;
    height: 100%;
    vertical-align: middle;
    margin-right: -1px; /* absorb the trailing inline-block whitespace */
  }
  .evo-tile .evo-add:hover { background: #6b91e6; }
  .evo-tile .evo-add:active { transform: scale(0.92); }
  .evo-connector {
    position: absolute;
    width: 220px;
    height: 235px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    padding-top: 3.5rem; /* room for the delete button at top */
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    justify-content: center;
  }
  .evo-connector .evo-save {
    height: 34px;
    padding: 0 0.7rem;
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 6px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s, opacity 0.15s;
  }
  .evo-connector .evo-save:hover:not(:disabled) { background: #6b91e6; border-color: #6b91e6; }
  .evo-connector .evo-save:disabled {
    background: var(--panel);
    color: var(--muted);
    border-color: var(--border);
    cursor: not-allowed;
    opacity: 0.55;
  }
  /* "X" button on the connector to remove the evolution */
  .evo-connector .evo-delete {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--danger);
    color: white;
    border: none;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    /* Same perfect-center technique as .evo-add: line-height = button height,
       ::before vertical-align:middle gives true baseline-centered glyphs. */
    line-height: 32px;
    text-align: center;
    transition: background 0.15s, transform 0.1s;
  }
  .evo-connector .evo-delete::before {
    content: '';
    display: inline-block;
    height: 100%;
    vertical-align: middle;
    margin-right: -1px;
  }
  .evo-connector .evo-delete:hover { background: #e0607a; }
  .evo-connector .evo-delete:active { transform: scale(0.92); }
  .evo-line {
    position: absolute;
    height: 235px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .evo-line::before {
    content: '';
    width: 100%;
    height: 2px;
    background: var(--accent);
  }
  .evo-arrow {
    position: absolute;
    width: 28px;
    height: 235px;
    display: flex;
    align-items: center;
    justify-content: flex-start; /* triangle flush to the left edge */
    pointer-events: none;
  }
  .evo-arrow::before {
    content: '';
    width: 0; height: 0;
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
    border-left: 24px solid var(--accent); /* bigger, fully fills the arrow box */
  }
  .evo-connector select,
  .evo-connector input {
    height: 34px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.6rem;
