<script>
  import { get } from 'svelte/store';
  import { speciesData, selectedPokemon, evolutionData } from '../lib/speciesState';

  interface PokemonData {
    label: string;
    types: [string, string];
    abilities: [string, string];
    baseHP: string;
    baseAttack: string;
    baseDefense: string;
    baseSpAttack: string;
    baseSpDefense: string;
    baseSpeed: string;
    [key: string]: any;
  }

  const typeOptions = [
    { value: 'TYPE_NORMAL', label: 'Normal', color: '#A8A878' },
    { value: 'TYPE_FIGHTING', label: 'Fighting', color: '#C03028' },
    { value: 'TYPE_FLYING', label: 'Flying', color: '#A890F0' },
    { value: 'TYPE_POISON', label: 'Poison', color: '#A040A0' },
    { value: 'TYPE_GROUND', label: 'Ground', color: '#E0C068' },
    { value: 'TYPE_ROCK', label: 'Rock', color: '#B8A038' },
    { value: 'TYPE_BUG', label: 'Bug', color: '#A8B820' },
    { value: 'TYPE_GHOST', label: 'Ghost', color: '#705898' },
    { value: 'TYPE_STEEL', label: 'Steel', color: '#B8B8D0' },
    { value: 'TYPE_MYSTERY', label: 'Mystery', color: '#68A090' },
    { value: 'TYPE_FIRE', label: 'Fire', color: '#F08030' },
    { value: 'TYPE_WATER', label: 'Water', color: '#6890F0' },
    { value: 'TYPE_GRASS', label: 'Grass', color: '#78C850' },
    { value: 'TYPE_ELECTRIC', label: 'Electric', color: '#F8D030' },
    { value: 'TYPE_PSYCHIC', label: 'Psychic', color: '#F85888' },
    { value: 'TYPE_ICE', label: 'Ice', color: '#98D8D8' },
    { value: 'TYPE_DRAGON', label: 'Dragon', color: '#7038F8' },
    { value: 'TYPE_DARK', label: 'Dark', color: '#705848' },
  ];

  function showStatus(message: string, type: 'success' | 'error') {
    const status = document.getElementById('status')!;
    status.textContent = message;
    status.className = `status show ${type}`;
    setTimeout(() => {
      status.classList.remove('show');
    }, 3000);
  }

  function loadPokemon(label: string) {
    const data = get(speciesData);
    if (!data) return;

    const pokemon = data.species.find((p: PokemonData) => p.label === label);
    if (!pokemon) return;

    currentLabel = label;

    document.getElementById('pokemon-name')!.textContent = label.replace('_', ' ');
    (document.getElementById('pokemon-sprite') as HTMLImageElement).src = `/api/sprite/${label.toLowerCase()}`;

    // Update type chips (chips are the type selector)
    updateTypeChip('type1-chip', pokemon.types[0]);
    updateTypeChip('type2-chip', pokemon.types[1]);

    // Update ability dropdowns
    (document.getElementById('ability1') as HTMLSelectElement).value = pokemon.abilities[0];
    (document.getElementById('ability2') as HTMLSelectElement).value = pokemon.abilities[1];

    // Update stats sliders
    const stats = ['baseHP', 'baseAttack', 'baseDefense', 'baseSpAttack', 'baseSpDefense', 'baseSpeed'];
    stats.forEach(stat => {
      const slider = document.getElementById(stat) as HTMLInputElement;
      const valueDisplay = document.getElementById(`${stat}-value`)!;
      const value = parseInt(pokemon[stat]);
      slider.value = value.toString();
      valueDisplay.textContent = value.toString();
    });

    // Update moves
    renderMoves(label);

    // Update evolution chain
    renderEvolution(label);

    document.getElementById('editor')!.style.display = 'block';
    document.getElementById('empty-state')!.style.display = 'none';
  }

  let learnsetsData: any = null;
  let currentLabel: string | null = null;
  const movesInfo: { names: Record<string, string>; moves: string[]; tms: string[]; hms: string[] } = JSON.parse(
    document.getElementById('moves-data')!.textContent!
  );

  function formatMoveName(move: string): string {
    if (movesInfo.names[move]) return movesInfo.names[move];
    return move.replace(/^MOVE_/, '').split('_').map(w => w ? w.charAt(0) + w.slice(1).toLowerCase() : w).join(' ');
  }

  // Pre-built <option> string for the move selector (shared by every level-up row)
  const moveOptionsHtml = movesInfo.moves
    .map(m => `<option value="${m}">${formatMoveName(m)}</option>`)
    .join('');

  function buildLevelupRow(entry: { level: number; level_padded?: string; move: string }, index: number) {
    const row = document.createElement('div');
    row.className = 'levelup-row';
    (row as any)._luEntry = entry;
    row.innerHTML = `
      <input type="number" class="move-level" min="1" max="100" value="${entry.level}">
      <select class="move-select">${moveOptionsHtml}</select>
      <button type="button" class="move-remove" title="Remove">×</button>
    `;
    const levelInput = row.querySelector('.move-level') as HTMLInputElement;
    const moveSelect = row.querySelector('.move-select') as HTMLSelectElement;
    moveSelect.value = entry.move;

    levelInput.addEventListener('input', () => {
      const lv = Math.max(1, Math.min(100, parseInt(levelInput.value) || 1));
      entry.level = lv;
      entry.level_padded = String(lv).padStart(2, ' ');
    });
    // Re-sort + animate only on commit (blur/Enter/select), not every keystroke
    levelInput.addEventListener('change', () => reorderLevelupAnimated());
    moveSelect.addEventListener('change', () => {
      entry.move = moveSelect.value;
      reorderLevelupAnimated();
    });
    row.querySelector('.move-remove')!.addEventListener('click', () => {
      const data = learnsetsData.learnsets[currentLabel!];
      data.levelup.splice(index, 1);
      renderMoves(currentLabel!);
    });

    return row;
  }

  function buildTmhmRow(move: string, kind: 'TM' | 'HM', number: number, checked: boolean) {
    const row = document.createElement('label');
    row.className = 'tmhm-row' + (kind === 'HM' ? ' is-hm' : '');
    row.innerHTML = `
      <input type="checkbox" class="tmhm-check" data-move="${move}" ${checked ? 'checked' : ''}>
      <span class="tmhm-tag">${kind}${String(number).padStart(2, '0')}</span>
      <span>${formatMoveName(move)}</span>
    `;
    const cb = row.querySelector('.tmhm-check') as HTMLInputElement;
    cb.addEventListener('change', () => {
      const data = learnsetsData.learnsets[currentLabel!];
      const set = new Set(data.tmhm);
      if (cb.checked) set.add(move);
      else set.delete(move);
      data.tmhm = [...set];
    });
    return row;
  }

  // Sort level-up moves by level (asc), then display name (asc).
  // Returns true if the order changed.
  function sortLevelup() {
    const data = learnsetsData.learnsets[currentLabel!];
    if (!data) return false;
    const before = data.levelup.map(e => `${e.level}:${e.move}`).join('|');
    data.levelup.sort((a, b) => {
      if (a.level !== b.level) return a.level - b.level;
      const an = movesInfo.names[a.move] ?? a.move;
      const bn = movesInfo.names[b.move] ?? b.move;
      return an.localeCompare(bn);
    });
    return data.levelup.map(e => `${e.level}:${e.move}`).join('|') !== before;
  }

  // FLIP-animate the levelup list into its new sorted order.
  function reorderLevelupAnimated() {
    if (!currentLabel) return;
    const list = document.getElementById('levelup-moves')!;
    const rows = Array.from(list.querySelectorAll('.levelup-row')) as HTMLElement[];
    if (rows.length === 0) return;

    // Capture old positions, keyed by the entry reference
    const oldRects = new Map<any, DOMRect>();
    for (const row of rows) {
      const entry = (row as any)._luEntry;
      if (entry) oldRects.set(entry, row.getBoundingClientRect());
    }

    // Re-sort in place
    sortLevelup();

    // Re-render in the new order (this destroys/recreates the DOM nodes)
    renderMoves(currentLabel!);

    // FLIP: apply inverse transform, then transition to identity
    const newRows = Array.from(list.querySelectorAll('.levelup-row')) as HTMLElement[];
    requestAnimationFrame(() => {
      for (const row of newRows) {
        const entry = (row as any)._luEntry;
        if (!entry) continue;
        const oldRect = oldRects.get(entry);
        if (!oldRect) continue;
        const newRect = row.getBoundingClientRect();
        const dx = oldRect.left - newRect.left;
        const dy = oldRect.top - newRect.top;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) continue;
        row.style.transition = 'none';
        row.style.transform = `translate(${dx}px, ${dy}px)`;
        void row.offsetHeight; // force reflow
        row.style.transition = 'transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1)';
        row.style.transform = '';
        const cleanup = () => {
          row.style.transition = '';
          row.style.transform = '';
          row.removeEventListener('transitionend', cleanup);
        };
        row.addEventListener('transitionend', cleanup);
        setTimeout(cleanup, 400);
      }
    });
  }

  function renderMoves(label: string) {
    const luList = document.getElementById('levelup-moves')!;
    const tmList = document.getElementById('tmhm-moves')!;
    luList.innerHTML = '';
    tmList.innerHTML = '';
    if (!learnsetsData) return;
    const entry = learnsetsData.learnsets?.[label];
    if (!entry) return;
    entry.levelup.forEach((m: any, i: number) => luList.appendChild(buildLevelupRow(m, i)));
    const checked = new Set(entry.tmhm);
    movesInfo.tms.forEach((move, i) => tmList.appendChild(buildTmhmRow(move, 'TM', i + 1, checked.has(move))));
    movesInfo.hms.forEach((move, i) => tmList.appendChild(buildTmhmRow(move, 'HM', i + 1, checked.has(move))));
  }

  document.getElementById('add-levelup')!.addEventListener('click', () => {
    if (!currentLabel || !learnsetsData) return;
    const data = learnsetsData.learnsets[currentLabel];
    data.levelup.push({ level: 1, level_padded: ' 1', move: movesInfo.moves[0] });
    renderMoves(currentLabel);
  });

  // ===== Evolution tree (horizontal layout) =====
  // buildEvolutionTree algorithm:
  //   1. Find the root of the line containing the current species by walking
  //      back through evoToParent until a species has no pre-evolution.
  //   2. Recursively layout the full subtree from the root: each node is
  //      placed at (x, y) and its children stack vertically to the right
  //      (x + TILE_W + CONN_W), with the parent vertically centered among
  //      its children. For a linear chain this produces a straight horizontal
  //      row; for branching nodes children spread vertically.
  //   3. Edges (connectors with method/param/target) are placed in the gap
  //      between each parent and child, vertically centered on the child.
  const TILE_W = 220, TILE_H = 235, CONN_W = 220, CONN_H = 235, ARROW_W = 28, TAIL_W = 20, ARROW_GAP = 20, V_GAP = 16, H_GAP = 16;
  // The connector and tile share the same height, so the connector sits flush
  // with the top of the child tile (TOP_PAD = 0). For branching nodes the
  // parent tile expands vertically to embrace all its children, and the
  // connector is centered on the child's vertical axis.
  const TOP_PAD = (CONN_H - TILE_H) / 2;
  // Effective vertical space a child takes, from the top of its incoming
  // connector to the bottom of its own (or its descendants') connector.
  // Used as the step between siblings so their connectors don't overlap.
  const ROW_H = CONN_H + TOP_PAD;
  type Pos = { label: string; x: number; y: number; height: number; isCurrent: boolean };
  type Edge = { from: string; toIndex: number; method: string; param: number; target: string; x: number; y: number };

  let evoFromMap = new Map<string, { method: string; param: number; target: string }[]>();
  let evoToParent = new Map<string, { from: string; toIndex: number }>();
  let speciesOptionsHtml = '';

  function rebuildEvoMaps() {
    evoFromMap = new Map();
    evoToParent = new Map();
    const data = get(evolutionData);
    if (!data) return;
    for (const e of data.evolutions) {
      evoFromMap.set(e.from, e.to);
      e.to.forEach((t, i) => evoToParent.set(t.target, { from: e.from, toIndex: i }));
    }
  }

  function findEvoRoot(label: string): string {
    let cur = label;
    const seen = new Set<string>();
    while (true) {
      if (seen.has(cur)) break;
      seen.add(cur);
      const p = evoToParent.get(cur);
      if (!p) break;
      cur = p.from;
    }
    return cur;
  }

  function paramType(method: string): 'level' | 'item' | 'beauty' | 'none' {
    if (method === 'EVO_LEVEL' || method === 'EVO_LEVEL_ATK_GT_DEF' || method === 'EVO_LEVEL_ATK_EQ_DEF' ||
        method === 'EVO_LEVEL_ATK_LT_DEF' || method === 'EVO_LEVEL_SILCOON' || method === 'EVO_LEVEL_CASCOON' ||
        method === 'EVO_LEVEL_NINJASK' || method === 'EVO_LEVEL_SHEDINJA') return 'level';
    if (method === 'EVO_ITEM' || method === 'EVO_TRADE_ITEM') return 'item';
    if (method === 'EVO_BEAUTY') return 'beauty';
    return 'none';
  }

  function layoutTree(label: string, x: number, y: number, isRoot: boolean, currentLabel: string, nodes: Pos[]): { width: number; height: number } {
    const outgoing = evoFromMap.get(label) || [];
    const isCurrent = label === currentLabel;
    if (outgoing.length === 0) {
      nodes.push({ label, x, y, height: TILE_H, isCurrent });
      // Effective row height: from the top of the incoming connector
      // (y - TOP_PAD) to the bottom of the outgoing side (y + CONN_H).
      return { width: TILE_W, height: ROW_H };
    }
    let childY = y;
    const bounds: { w: number; h: number }[] = [];
    for (const edge of outgoing) {
      const r = layoutTree(edge.target, x + TILE_W + 2 * ARROW_W + CONN_W + TAIL_W + ARROW_GAP, childY, false, currentLabel, nodes);
      bounds.push({ w: r.width, h: r.height });
      childY += r.height + V_GAP;
    }
    const totalChildH = bounds.reduce((s, b) => s + b.h, 0) + (outgoing.length - 1) * V_GAP;
    // The parent tile expands vertically to embrace the full extent of its
    // children (with a minimum of TILE_H for leaf-sized fallback). This makes
    // branching nodes like Wurmple render as a tall card that visually
    // contains both evolutions.
    const parentHeight = Math.max(TILE_H, totalChildH);
    // The root is placed at the top (not centered) so the topmost connector
    // (centered on the first child) is flush at y=0. Non-root nodes are
    // centered vertically among their children for a balanced look.
    const nodeY = isRoot ? y : y + (totalChildH - parentHeight) / 2;
    nodes.push({ label, x, y: nodeY, height: parentHeight, isCurrent });
    const maxChildW = Math.max(...bounds.map(b => b.w));
    return { width: TILE_W + 2 * ARROW_W + CONN_W + TAIL_W + ARROW_GAP + maxChildW, height: Math.max(ROW_H, totalChildH) };
  }

  function buildEvoTile(label: string, isCurrent: boolean, x: number, y: number, height: number): HTMLDivElement {
    const tile = document.createElement('div');
    tile.className = 'evo-tile' + (isCurrent ? ' is-current' : '');
    tile.style.left = x + 'px';
    tile.style.top = y + 'px';
    tile.style.height = height + 'px';
    tile.innerHTML = `<img class="evo-sprite" src="/api/sprite/${label.toLowerCase()}" alt=""><span class="evo-name">${label.replace(/_/g, ' ')}</span>`;
    if (isCurrent) {
      const add = document.createElement('button');
      add.type = 'button';
      add.className = 'evo-add';
      add.textContent = '+';
      add.title = 'Add evolution';
      add.addEventListener('click', () => {
        const evo = get(evolutionData);
        if (!evo) return;
        let entry = evo.evolutions.find(e => e.from === label);
        if (!entry) { entry = { from: label, to: [] }; evo.evolutions.push(entry); }
        const firstSpecies = get(speciesData)?.species?.[0]?.label ?? label;
        entry.to.push({ method: 'EVO_LEVEL', param: 1, target: firstSpecies });
        if (currentLabel) renderEvolution(currentLabel);
      });
      tile.appendChild(add);
    }
    return tile;
  }

  function buildEvoConnector(edge: Edge): HTMLDivElement {
    const conn = document.createElement('div');
    conn.className = 'evo-connector';
    conn.style.left = edge.x + 'px';
    conn.style.top = edge.y + 'px';
    const methodSel = document.createElement('select');
    methodSel.className = 'evo-method';
    methodSel.innerHTML = evoOptionsHtml;
    methodSel.value = edge.method;
    const paramWrap = document.createElement('div');
    paramWrap.className = 'evo-param-wrap';
    const targetSel = document.createElement('select');
    targetSel.className = 'evo-target';
    targetSel.innerHTML = speciesOptionsHtml;
    targetSel.value = edge.target;
    const saveBtn = document.createElement('button');
    saveBtn.type = 'button';
    saveBtn.className = 'evo-save';
    saveBtn.textContent = 'Save';
    const deleteBtn = document.createElement('button');
    deleteBtn.type = 'button';
    deleteBtn.className = 'evo-delete';
    deleteBtn.textContent = '×';
    deleteBtn.title = 'Remove evolution';
    conn.append(methodSel, paramWrap, targetSel, saveBtn, deleteBtn);

    const data = get(evolutionData);
    const entryRef = data?.evolutions.find(e => e.from === edge.from);

    // Draft state: edits to method/param/target stay local until "Save" is
    // pressed, so the user can finish filling in the details before the
    // tree is recomputed.
    let draftMethod = edge.method;
    let draftParam = edge.param;
    let draftTarget = edge.target;

    // Save is disabled until the user actually changes something; the tree
    // only needs to be recomputed when there's something new to commit.
    const refreshSaveState = () => {
      const dirty = draftMethod !== edge.method
        || draftParam !== edge.param
        || draftTarget !== edge.target;
      saveBtn.disabled = !dirty;
    };
    refreshSaveState();

    const buildParam = (method: string, current: number) => {
      paramWrap.innerHTML = '';
      const t = paramType(method);
      if (t === 'none') return;
      if (t === 'item') {
        // EVO_ITEM / EVO_TRADE_ITEM: show a real item dropdown. The stored
        // param is the item's numeric constant; we look it up by number and
        // write back the number on change.
        const match = evoItems.find(i => i.number === current);
        const sel = document.createElement('select');
        sel.className = 'evo-item-select';
        sel.innerHTML = evoItemOptionsHtml;
        sel.value = match?.value ?? evoItems[0]?.value ?? '';
        sel.addEventListener('change', () => {
          const picked = evoItems.find(i => i.value === sel.value);
          draftParam = picked ? picked.number : 0;
          refreshSaveState();
        });
        paramWrap.appendChild(sel);
        return;
      }
      const inp = document.createElement('input');
      inp.type = 'number';
      if (t === 'level') { inp.min = '1'; inp.max = '100'; }
      else if (t === 'beauty') { inp.min = '0'; inp.max = '255'; }
      inp.value = String(current);
      inp.addEventListener('input', () => {
        draftParam = parseInt(inp.value) || 0;
        refreshSaveState();
      });
      paramWrap.appendChild(inp);
    };
    buildParam(draftMethod, draftParam);

    methodSel.addEventListener('change', () => {
      draftMethod = methodSel.value;
      if (paramType(draftMethod) === 'none') draftParam = 0;
      buildParam(draftMethod, draftParam);
      refreshSaveState();
    });
    targetSel.addEventListener('change', () => {
      draftTarget = targetSel.value;
      refreshSaveState();
    });
    saveBtn.addEventListener('click', () => {
      if (entryRef) {
        entryRef.to[edge.toIndex].method = draftMethod;
        entryRef.to[edge.toIndex].param = draftParam;
        entryRef.to[edge.toIndex].target = draftTarget;
      }
      if (currentLabel) renderEvolution(currentLabel);
    });
    deleteBtn.addEventListener('click', () => {
      if (entryRef && data) {
        entryRef.to.splice(edge.toIndex, 1);
        if (entryRef.to.length === 0) {
          data.evolutions = data.evolutions.filter(e => e.from !== edge.from);
        }
      }
      if (currentLabel) renderEvolution(currentLabel);
    });
    return conn;
  }

  function renderEvolution(label: string) {
    const container = document.getElementById('evolution-chain')!;
    container.innerHTML = '';
    const data = get(evolutionData);
    if (!data) {
      container.innerHTML = '<div class="evo-empty">Loading…</div>';
      return;
    }
    rebuildEvoMaps();
    const sp = get(speciesData);
    if (sp) {
      speciesOptionsHtml = sp.species
        .map((s: any) => `<option value="${s.label}">${s.label.replace(/_/g, ' ')}</option>`)
        .join('');
    }
    const root = findEvoRoot(label);
    const rootChildren = evoFromMap.get(root) || [];
    const nodes: Pos[] = [];
    // If the root has children, shift it down by TOP_PAD so the topmost
    // connector/line (centered on the first child) starts at y=0.
    const startY = rootChildren.length > 0 ? TOP_PAD : 0;
    const bounds = layoutTree(root, 0, startY, true, label, nodes);

    // Height must cover the bottom of the deepest node (tile or expanded
    // branching tile), not just the connector height.
    const boundsHeight = rootChildren.length > 0
      ? Math.max(...nodes.map(n => n.y + n.height))
      : TILE_H;

    const nodeMap = new Map(nodes.map(n => [n.label, n]));
    const edges: Edge[] = [];
    for (const [from, toList] of evoFromMap) {
      const pNode = nodeMap.get(from);
      if (!pNode) continue;
      toList.forEach((edge, toIndex) => {
        const cNode = nodeMap.get(edge.target);
        if (!cNode) return;
        edges.push({
          from, toIndex,
          method: edge.method, param: edge.param, target: edge.target,
          x: pNode.x + TILE_W + ARROW_W,            // connector sits after the first arrow
          y: cNode.y + (cNode.height - CONN_H) / 2, // center the connector on the child's vertical axis
        });
      });
    }

    container.style.width = bounds.width + 'px';
    container.style.height = boundsHeight + 'px';

    for (const n of nodes) {
      container.appendChild(buildEvoTile(n.label, n.isCurrent, n.x, n.y, n.height));
    }
    for (let i = 0; i < edges.length; i++) {
      const e = edges[i];
      // Lines and arrow head sit at e.y; their CONN_H container is centered
      // on the connector (which is centered on the child's vertical axis).
      const lineTop = e.y;
      // Line from parent tile to connector
      const ln = document.createElement('div');
      ln.className = 'evo-line';
      ln.style.left = (e.x - ARROW_W) + 'px';
      ln.style.top = lineTop + 'px';
      ln.style.width = ARROW_W + 'px';
      container.appendChild(ln);
      // Connector
      container.appendChild(buildEvoConnector(e));
      // Arrow tail (line) from connector to child
      const tl = document.createElement('div');
      tl.className = 'evo-line';
      tl.style.left = (e.x + CONN_W) + 'px';
      tl.style.top = lineTop + 'px';
      tl.style.width = TAIL_W + 'px';
      container.appendChild(tl);
      // Arrow head from tail to child tile
      const ah = document.createElement('div');
      ah.className = 'evo-arrow';
      ah.style.left = (e.x + CONN_W + TAIL_W) + 'px';
      ah.style.top = lineTop + 'px';
      container.appendChild(ah);
    }
  }

  // TM/HM search: filter rows by name/tag substring (case-insensitive)
  document.getElementById('tmhm-search')!.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    const list = document.getElementById('tmhm-moves')!;
    list.querySelectorAll('.tmhm-row').forEach(row => {
      const text = (row.textContent ?? '').toLowerCase();
      (row as HTMLElement).style.display = !q || text.includes(q) ? '' : 'none';
    });
  });

  // Load learnsets; if a Pokémon is already selected, populate its moves
  (async () => {
    try {
      const res = await fetch('/api/learnsets');
      if (res.ok) {
        learnsetsData = await res.json();
        if (currentLabel) renderMoves(currentLabel);
      }
    } catch {}
  })();

  // Load evolution data (methods, items, evolutions)
  let evoMethods: { value: string; label: string }[] = [];
  let evoItems: { value: string; label: string }[] = [];
  let evoOptionsHtml = '';
  let evoItemOptionsHtml = '';
  (async () => {
    try {
      const res = await fetch('/api/evolution');
      if (res.ok) {
        const d = await res.json();
        evolutionData.set(d);
        evoMethods = d.methods;
        evoItems = d.items;
        evoOptionsHtml = evoMethods.map(m => `<option value="${m.value}">${m.label}</option>`).join('');
        evoItemOptionsHtml = evoItems.map(i => `<option value="${i.value}">${i.label}</option>`).join('');
        if (currentLabel) renderEvolution(currentLabel);
      }
    } catch {}
  })();

  function updateTypeChip(chipId: string, typeValue: string) {
    const chip = document.getElementById(chipId)!;
    const typeInfo = typeOptions.find(t => t.value === typeValue);
    if (typeInfo) {
      chip.textContent = typeInfo.label;
      chip.style.backgroundColor = typeInfo.color;
      chip.dataset.type = typeValue;
    }
  }

  // Type picker: clicking a type chip opens a popover with all type options as chips
  const typePicker = document.getElementById('type-picker')!;
  let pickerTarget: string | null = null;

  function openTypePicker(chipId: string) {
    pickerTarget = chipId;
    typePicker.innerHTML = '';
    for (const t of typeOptions) {
      const opt = document.createElement('button');
      opt.type = 'button';
      opt.className = 'type-chip type-picker-option';
      opt.textContent = t.label;
      opt.style.backgroundColor = t.color;
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        if (pickerTarget) updateTypeChip(pickerTarget, t.value);
        closeTypePicker();
      });
      typePicker.appendChild(opt);
    }
    const anchor = document.getElementById(chipId)!.getBoundingClientRect();
    typePicker.style.top = `${anchor.bottom + 4}px`;
    typePicker.style.left = `${anchor.left}px`;
    typePicker.hidden = false;
  }

  function closeTypePicker() {
    typePicker.hidden = true;
    pickerTarget = null;
  }

  document.getElementById('type1-chip')!.addEventListener('click', (e) => {
    e.stopPropagation();
    openTypePicker('type1-chip');
  });
  document.getElementById('type2-chip')!.addEventListener('click', (e) => {
    e.stopPropagation();
    openTypePicker('type2-chip');
  });
  document.addEventListener('click', () => {
    if (!typePicker.hidden) closeTypePicker();
  });

  // React to Pokémon selection from the Svelte list
  selectedPokemon.subscribe((label) => {
    if (label) loadPokemon(label);
  });

  document.getElementById('pokemon-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = get(speciesData);
    const label = get(selectedPokemon);
    if (!data || !label) return;

    const pokemon = data.species.find((p: PokemonData) => p.label === label);
    if (!pokemon) return;

    pokemon.types[0] = document.getElementById('type1-chip')!.dataset.type!;
    pokemon.types[1] = document.getElementById('type2-chip')!.dataset.type!;
    pokemon.abilities[0] = (document.getElementById('ability1') as HTMLSelectElement).value;
    pokemon.abilities[1] = (document.getElementById('ability2') as HTMLSelectElement).value;

    // Update stats from sliders
    const stats = ['baseHP', 'baseAttack', 'baseDefense', 'baseSpAttack', 'baseSpDefense', 'baseSpeed'];
    stats.forEach(stat => {
      const slider = document.getElementById(stat) as HTMLInputElement;
      pokemon[stat] = slider.value;
    });

    try {
      const evo = get(evolutionData);
      const [speciesRes, learnsetsRes, evoRes] = await Promise.all([
        fetch('/api/species', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        }),
        fetch('/api/learnsets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ learnsets: learnsetsData.learnsets }),
        }),
        fetch('/api/evolution', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(evo),
        }),
      ]);

      const showErr = async (res: Response, kind: string) => {
        const body = await res.json().catch(() => ({}));
        console.error(`Save ${kind} failed`, res.status, body);
        showStatus(`Failed to save ${kind}: ${body.error ?? res.statusText}`, 'error');
      };

      if (speciesRes.ok && learnsetsRes.ok && evoRes.ok) {
        showStatus('Changes saved (species + moves + evolution)!', 'success');
      } else {
        if (!speciesRes.ok) await showErr(speciesRes, 'species');
        else if (!learnsetsRes.ok) await showErr(learnsetsRes, 'moves');
        else if (!evoRes.ok) await showErr(evoRes, 'evolution');
      }
    } catch (error) {
      console.error('Save threw', error);
      showStatus(`Error saving: ${error instanceof Error ? error.message : String(error)}`, 'error');
    }
  });

  // Update stat values when sliders change
  const stats = ['baseHP', 'baseAttack', 'baseDefense', 'baseSpAttack', 'baseSpDefense', 'baseSpeed'];
  stats.forEach(stat => {
    const slider = document.getElementById(stat) as HTMLInputElement;
    const valueDisplay = document.getElementById(`${stat}-value`)!;
    slider.addEventListener('input', () => {
      valueDisplay.textContent = slider.value;
    });
  });
</script>
