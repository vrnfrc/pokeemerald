---
interface Props {
  id: string;
  label: string;
  value: string;
  options: { value: string; label: string }[];
  onChange?: string;
}

const { id, label, value, options } = Astro.props;
---

<div class="searchable-select">
  <label for={id}>{label}</label>
  <input
    type="text"
    id={`${id}-search`}
    class="search-input"
    placeholder="Search..."
    autocomplete="off"
  />
  <select id={id} name={id}>
    {options.map(opt => (
      <option value={opt.value} selected={opt.value === value}>{opt.label}</option>
    ))}
  </select>
</div>

<style>
  .searchable-select {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  label {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 500;
  }
  .search-input {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    margin-bottom: 0.3rem;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  select {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5rem 0.6rem;
    cursor: pointer;
  }
  select:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>

<script>
  class SearchableSelect {
    constructor(container: HTMLElement) {
      const searchInput = container.querySelector('.search-input') as HTMLInputElement;
      const select = container.querySelector('select') as HTMLSelectElement;
      const options = Array.from(select.querySelectorAll('option'));

      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase();
        options.forEach(opt => {
          const text = opt.textContent?.toLowerCase() || '';
          const value = opt.value.toLowerCase();
          const match = text.includes(query) || value.includes(query);
          opt.hidden = !match;
        });
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const visible = options.filter(opt => !opt.hidden);
          if (visible.length > 0) {
            select.value = visible[0].value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            searchInput.value = '';
            options.forEach(opt => opt.hidden = false);
          }
        }
      });

      select.addEventListener('change', () => {
        const selected = options.find(opt => opt.value === select.value);
        if (selected) {
          searchInput.value = selected.textContent || '';
        }
      });

      const selected = options.find(opt => opt.selected);
      if (selected) {
        searchInput.value = selected.textContent || '';
      }
    }
  }

  document.querySelectorAll('.searchable-select').forEach(el => {
    new SearchableSelect(el as HTMLElement);
  });
</script>
